{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.7.4"
    },
    {
      "src": "pages/**/*.php",
      "use": "vercel-php@0.7.4"
    },
    {
      "src": "pages/img/**",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/img/(.*)",
      "dest": "/pages/img/$1"
    },
    {
      "src": "/revieweo/pages/(.*)",
      "dest": "/pages/$1"
    },
    {
      "src": "/revieweo/auth/(.*)",
      "dest": "/Auth/$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
